--- a/src/parse.ts
+++ b/src/parse.ts
@@ -104,7 +104,7 @@ const readTime = (text: string): number | undefined => {
   }
 
   // Digits past the millisecond are dropped, not rounded.
-  const millisecond = whole((groups.fraction ?? "").padEnd(3, "0").slice(0, 3));
+  const millisecond = Math.round(Number(`0.${groups.fraction ?? "0"}`) * 1000);
 
