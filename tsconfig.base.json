{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [],
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": [
          "effect",
          "@effect/platform-bun",
          "@effect/platform-node"
        ],
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "error",
          "unsafeEffectTypeAssertion": "error",
          "floatingEffect": "error",
          "floatingEffectInVitest": "error",
          "missingEffectContext": "error",
          "missingEffectError": "error",
          "missingLayerContext": "error",
          "leakingRequirements": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "unknownInEffectCatch": "error",
          "tryCatchInEffectGen": "error",
          "returnEffectInGen": "error",
          "runEffectInsideEffect": "error",
          "schemaSyncInEffect": "error",
          "instanceOfSchema": "error",
          "newPromise": "error",
          "asyncFunction": "error",
          "globalConsole": "error",
          "globalConsoleInEffect": "error",
          "globalDate": "error",
          "globalDateInEffect": "error",
          "globalFetch": "error",
          "globalFetchInEffect": "error",
          "globalRandom": "error",
          "globalRandomInEffect": "error",
          "globalTimers": "error",
          "globalTimersInEffect": "error",
          "cryptoRandomUUID": "error",
          "cryptoRandomUUIDInEffect": "error",
          "nodeBuiltinImport": "error",
          "strictEffectProvide": "off",
          "lazyEffect": "off",
          "strictBooleanExpressions": "off",
          "outdatedApi": "error",
          "unstableApiUsage": "error",
          "experimentalApiUsage": "error"
        },
        "allowedUnstableApis": [],
        "overrides": [
          {
            "include": ["scripts/**/*.ts"],
            "options": {
              "allowedUnstableApis": ["effect/process"]
            }
          },
          {
            "include": ["scripts/gen.ts", "scripts/lib/gen.ts"],
            "options": {
              "allowedUnstableApis": [
                "effect/ai",
                "effect/cli",
                "effect/process",
                "effect/rpc"
              ]
            }
          },
          {
            "include": ["packages/config/test/**/*.ts"],
            "options": {
              "allowedUnstableApis": ["effect/process"]
            }
          },
          {
            "include": ["apps/platform/**/*.ts"],
            "options": {
              "allowedUnstableApis": ["effect/ai", "effect/http", "effect/rpc"]
            }
          },
          {
            "include": ["apps/cli/**/*.ts"],
            "options": {
              "allowedUnstableApis": [
                "effect/ai",
                "effect/cli",
                "effect/http",
                "effect/rpc"
              ]
            }
          },
          {
            "include": ["packages/protocol/src/**/*.ts"],
            "options": {
              "allowedUnstableApis": ["effect/ai", "effect/cli", "effect/rpc"]
            }
          },
          {
            "include": ["packages/protocol/src/domain/**/*.ts"],
            "options": {
              "allowedUnstableApis": []
            }
          },
          {
            "include": ["packages/protocol/test/**/*.ts"],
            "options": {
              "allowedUnstableApis": [
                "effect/ai",
                "effect/cli",
                "effect/http",
                "effect/rpc"
              ]
            }
          },
          {
            "include": ["packages/git/test/**/*.ts"],
            "options": {
              "allowedUnstableApis": ["effect/http", "effect/process"]
            }
          },
          {
            "include": ["packages/project/src/**/*.ts"],
            "options": {
              "allowedUnstableApis": ["effect/sql"]
            }
          },
          {
            "include": ["packages/project/test/**/*.ts"],
            "options": {
              "allowedUnstableApis": ["effect/Arbitrary", "effect/sql"]
            }
          },
          {
            "include": [
              "packages/checks/src/check-runner/local.ts",
              "packages/rules/src/rules-evaluator/bun.ts",
              "packages/testkit/src/**/*.ts"
            ],
            "options": {
              "allowedUnstableApis": ["effect/process"]
            }
          },
          {
            "include": [
              "packages/artifacts/test/**/*.ts",
              "packages/checks/test/**/*.ts",
              "packages/rules/test/**/*.ts",
              "packages/testkit/test/**/*.ts"
            ],
            "options": {
              "allowedUnstableApis": ["effect/process"]
            }
          },
          {
            "include": ["packages/artifacts/src/repo-host/local.ts"],
            "options": {
              "diagnosticSeverity": { "nodeBuiltinImport": "off" }
            }
          }
        ]
      }
    ]
  }
}
