# This repo's own env: the shared root that infra/ and app schemas import.
# Committed; it holds names, types and public defaults, never secret values.
# A person sets values in the gitignored .env.local beside each schema,
# encrypted with `varlock encrypt --file`. Agents never read .env files; they
# run `bun run env:check` (values redacted) and edit only .env.schema files.
#
# @currentEnv=$APP_ENV
# @defaultRequired=infer @defaultSensitive=false
# ---

# The environment tools run for. varlock infers it: `test` under vitest,
# `preview` or the CI branch's environment in CI, `development` otherwise.
# @type=enum(development, preview, staging, production, test)
APP_ENV=$VARLOCK_ENV
