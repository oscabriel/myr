node_modules/
dist/
.turbo/
coverage/
.wrangler/
*.log
.DS_Store

# varlock: keep .env.schema; local values stay out of git
.env
.env.local
.env.*.local
.dev.vars*
env.d.ts

# TanStack Router's route tree, generated by apps/web's `routes` script (and
# by `vite dev` and `vite build`). Never committed: the web's route issues
# run in parallel and would conflict on it. The web's `dist/` and `.wrangler/`
# and the examples' `node_modules/` fall under the patterns above.
apps/web/src/routeTree.gen.ts

# The build's spec and issues name local paths and the private plan, so they
# stay out of the public repo unless the user publishes a scrubbed copy. A
# worktree holds only tracked files, so every agent reads them by absolute path
# in the main checkout.
.agents/scratch/build/

# The swarm's per-run scratch: each agent's clone, CLI shims, harness sessions
# and config, and the run's `agents.json` summary. A live run records what it
# shows in its own notes, never here.
.swarm/

# The CLI's release: the two single-file binaries and `install.sh`, uploaded
# to a stage's releases bucket, never committed.
apps/cli/release/

# The deploy lock for recording days (`bun infra/recording.ts on`): a
# machine's own state while a take runs, never committed.
infra/.recording

# The Playwright check of a deployed web: one screenshot per page, for the
# shot list.
apps/web/e2e/out/

# impeccable's working files: its design context and surface briefs, a
# machine's own design notes, never committed.
.impeccable/

# Agent worktrees Claude Code makes inside the checkout.
.claude/worktrees/
