{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "types": {
      "outputs": ["worker-configuration.d.ts"]
    },
    "typecheck": {
      "dependsOn": ["types", "^types"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["types", "^types"],
      "env": ["UPDATE_GOLDEN"],
      "outputs": []
    },
    "@repo/project#test": {
      "dependsOn": ["types", "^types"],
      "env": ["UPDATE_GOLDEN"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/platform/migrations/**"],
      "outputs": []
    },
    "@repo/checks#test": {
      "dependsOn": ["types", "^types"],
      "env": ["UPDATE_GOLDEN"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/*/*",
        "$TURBO_ROOT$/examples/*/.*/**",
        "$TURBO_ROOT$/examples/*/packages/*/package.json",
        "!$TURBO_ROOT$/examples/*/.env*"
      ],
      "outputs": []
    },
    "@repo/rules#test": {
      "dependsOn": ["types", "^types"],
      "env": ["UPDATE_GOLDEN"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/*/*",
        "$TURBO_ROOT$/examples/*/.*/**",
        "$TURBO_ROOT$/examples/*/packages/*/package.json",
        "!$TURBO_ROOT$/examples/*/.env*"
      ],
      "outputs": []
    },
    "@repo/cli#test": {
      "dependsOn": ["types", "^types"],
      "env": ["UPDATE_GOLDEN"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/platform/src/**",
        "$TURBO_ROOT$/apps/platform/test/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/examples/datekit/**",
        "!$TURBO_ROOT$/examples/datekit/.env",
        "!$TURBO_ROOT$/examples/datekit/.env.local",
        "!$TURBO_ROOT$/examples/datekit/.env.*.local"
      ],
      "outputs": []
    },
    "@repo/config#test": {
      "cache": false,
      "dependsOn": ["types", "^types"],
      "outputs": []
    }
  }
}
