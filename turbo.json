{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "types": {
      "outputs": ["worker-configuration.d.ts"]
    },
    "typecheck": {
      "dependsOn": ["types", "^types"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["types", "^types"],
      "env": ["UPDATE_GOLDEN"],
      "outputs": []
    },
    "@repo/project#test": {
      "dependsOn": ["types", "^types"],
      "env": ["UPDATE_GOLDEN"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/platform/migrations/**"],
      "outputs": []
    },
    "@repo/checks#test": {
      "dependsOn": ["types", "^types"],
      "env": ["UPDATE_GOLDEN"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/*/*",
        "$TURBO_ROOT$/examples/*/.*/**",
        "$TURBO_ROOT$/examples/*/packages/*/package.json"
      ],
      "outputs": []
    },
    "@repo/rules#test": {
      "dependsOn": ["types", "^types"],
      "env": ["UPDATE_GOLDEN"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/*/*",
        "$TURBO_ROOT$/examples/*/.*/**",
        "$TURBO_ROOT$/examples/*/packages/*/package.json"
      ],
      "outputs": []
    },
    "@repo/config#test": {
      "cache": false,
      "dependsOn": ["types", "^types"],
      "outputs": []
    }
  }
}
