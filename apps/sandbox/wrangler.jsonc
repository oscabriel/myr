{
  // The sandbox Worker: the Checker and the Lander, each a Durable Object
  // with its own container, reached only through the platform's `SANDBOX`
  // service binding (its default entrypoint's RPC). It has no Artifacts
  // binding of any kind: tokens arrive in jobs, minted per job by the
  // platform. Deploy only through infra/deploy.ts, to an explicit stage.
  //
  // The top level is stage `local`: it builds and types the Worker and is
  // never deployed. Each stage under `env` repeats the containers and
  // Durable Objects, since wrangler does not inherit them.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandbox",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-05",
  // The Sandbox SDK's `Files` needs it.
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  // A stack trace in the logs, or an Issue, names the source.
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  // The Worker's own: every invocation's logs and trace, unsampled, and
  // Issues. Every stage inherits it; a container's logs are its own, below.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
    "issues": { "enabled": true },
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Checker", "Lander"] }],
  "durable_objects": {
    "bindings": [
      { "name": "CHECKER", "class_name": "Checker" },
      { "name": "LANDER", "class_name": "Lander" },
    ],
  },
  // Untrusted answer code runs in a Checker; the Lander runs only git and
  // Bun. One container per Durable Object, which picks its instance size when
  // it starts it (`ctx.container.start`).
  //
  // A container's own logs are off in a Checker: held-back checks run there,
  // and nothing a sealed check writes may reach a log (principle 7). They are
  // on in the Lander, which reads and writes only the public namespace's
  // repos (canonical and forks), never a layer, and hands git its token in
  // env, never in a URL or an argument. Each stage sets both again: a
  // container that leaves `observability` out keeps whatever it last had.
  "containers": [
    {
      "class_name": "Checker",
      "scheduling_policy": "durable_object",
      "observability": { "enabled": false },
      "images": { "check": { "dockerfile": "./images/check.Dockerfile" } },
    },
    {
      "class_name": "Lander",
      "scheduling_policy": "durable_object",
      "observability": { "enabled": true },
      // The repo root, so the image can carry the sdk for `bundleRules`
      // (land.Dockerfile.dockerignore admits only what it copies).
      "images": {
        "land": {
          "dockerfile": "./images/land.Dockerfile",
          "build_context": "../..",
        },
      },
    },
  ],
  "env": {
    "dev-oscabriel": {
      "durable_objects": {
        "bindings": [
          { "name": "CHECKER", "class_name": "Checker" },
          { "name": "LANDER", "class_name": "Lander" },
        ],
      },
      "containers": [
        {
          "class_name": "Checker",
          "scheduling_policy": "durable_object",
          "observability": { "enabled": false },
          "images": {
            "check": { "dockerfile": "./images/check.Dockerfile" },
          },
        },
        {
          "class_name": "Lander",
          "scheduling_policy": "durable_object",
          "observability": { "enabled": true },
          "images": {
            "land": {
              "dockerfile": "./images/land.Dockerfile",
              "build_context": "../..",
            },
          },
        },
      ],
    },
    "demo": {
      "durable_objects": {
        "bindings": [
          { "name": "CHECKER", "class_name": "Checker" },
          { "name": "LANDER", "class_name": "Lander" },
        ],
      },
      "containers": [
        {
          "class_name": "Checker",
          "scheduling_policy": "durable_object",
          "observability": { "enabled": false },
          "images": {
            "check": { "dockerfile": "./images/check.Dockerfile" },
          },
        },
        {
          "class_name": "Lander",
          "scheduling_policy": "durable_object",
          "observability": { "enabled": true },
          "images": {
            "land": {
              "dockerfile": "./images/land.Dockerfile",
              "build_context": "../..",
            },
          },
        },
      ],
    },
    "prod": {
      "durable_objects": {
        "bindings": [
          { "name": "CHECKER", "class_name": "Checker" },
          { "name": "LANDER", "class_name": "Lander" },
        ],
      },
      "containers": [
        {
          "class_name": "Checker",
          "scheduling_policy": "durable_object",
          "observability": { "enabled": false },
          "images": {
            "check": { "dockerfile": "./images/check.Dockerfile" },
          },
        },
        {
          "class_name": "Lander",
          "scheduling_policy": "durable_object",
          "observability": { "enabled": true },
          "images": {
            "land": {
              "dockerfile": "./images/land.Dockerfile",
              "build_context": "../..",
            },
          },
        },
      ],
    },
  },
}
