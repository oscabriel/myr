{
  // The platform Worker: the contracts over RPC at /rpc and MCP at /mcp, git
  // smart HTTP for every project's repos, the Project Durable Object and the
  // Answer and OnPush Workflows. Deploy only through infra/deploy.ts, to an
  // explicit stage.
  //
  // The top level is stage `local`: it builds and types the Worker and is
  // never deployed. Each stage under `env` repeats every binding, since
  // wrangler does not inherit bindings into an environment. Resource names
  // are jobs plus the stage, never the brand. A `database_id` or
  // KV `id` of zeros is a placeholder that infra/bootstrap.ts replaces with
  // the id of the resource it made.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "platform",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-05",
  // isomorphic-git needs `Buffer` (the /isogit Lander). The OAuth provider
  // resolves a Client ID Metadata Document (the CLI's, served at /oauth/cli,
  // and an MCP client's) only with `global_fetch_strictly_public`, which
  // sends the fetch through the public internet (SSRF protection).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Rat Stack's byte limits are for a minified bundle (scripts/startup-budget.ts).
  "minify": true,
  // esbuild's name-keeping wraps every function and class in a helper call
  // that restores its name after minifying: about 130 KB of the entry.
  // Nothing here reads a name at run time: Effect's tagged errors
  // set `name` from their tag, services are keyed by strings, and the
  // runtime finds Durable Objects, Workflows and entrypoints by export name,
  // which minifying keeps. A stack trace shows minified names and positions.
  // The uploaded source maps take an uncaught exception's stack back to the
  // source, but a defect the platform reports itself is logged as thrown:
  // the same commit's `wrangler deploy --dry-run --outdir` gives the map to
  // read it by (README, Observability).
  "keep_names": false,
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": false,
  // Smart Placement runs the Worker near the stores each request waits on (the
  // Project DO, D1, R2), not near the caller: a page's reads go one hop to the
  // platform and then stay local, and fewer locations keep their isolates warm.
  // `placement` is inherited by every env.
  "placement": { "mode": "smart" },
  // Every invocation's logs and trace, unsampled, and Issues, which groups
  // what failed. The runtime's own spans record each Durable Object SQL
  // statement's bound values and each fetch's full URL, so these traces hold
  // the Project DO's layer names and repos and sealed values (never a plain
  // one). The maintainer keeps them in the account's trace store alone: no
  // `destinations`, and no Issues automation sends the platform's anywhere
  // (principle 7).
  // Unlike bindings, wrangler gives `observability` and `upload_source_maps`
  // to every stage that does not set its own
  // (packages/config/test/observability.test.ts holds each stage to them).
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
    "issues": { "enabled": true },
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Project"] }],
  "vars": {
    // Until sign-in exists, one operator holds a session.
    "OPERATOR_HANDLE": "oscabriel",
    "STAGE": "local",
    // "container" (apps/sandbox) or "isogit" (in this Worker).
    "LANDER_ADAPTER": "container",
    // The Workers AI model that drafts asks; swap it here, no code change.
    "DRAFT_MODEL": "@cf/moonshotai/kimi-k2.7-code",
    // The web app, which `/` links to: `vite dev`'s URL locally.
    "PUBLIC_WEB_URL": "http://localhost:5173",
  },
  "secrets": {
    // Declared in .env.schema; the user sets the values. SESSION_TOKENS is
    // optional; sign-in's cookie key and pepper are not, since accounts are
    // the platform's own and need no third party. MASTER_KEY wraps every
    // write-only env value: without it none can be stored or opened.
    "required": [
      "OPERATOR_TOKEN",
      "COOKIE_KEY",
      "PASSWORD_PEPPER",
      "MASTER_KEY",
    ],
  },
  "durable_objects": {
    "bindings": [{ "name": "PROJECT", "class_name": "Project" }],
  },
  "workflows": [
    { "name": "answer-local", "binding": "ANSWER", "class_name": "Answer" },
    { "name": "on-push-local", "binding": "ON_PUSH", "class_name": "OnPush" },
  ],
  // The public namespace, and the private one that holds every project's
  // layer repos. Only this Worker binds the private one: the Workers
  // that serve public pages bind neither (principle 7).
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "projects-local" },
    { "binding": "ARTIFACTS_PRIVATE", "namespace": "layers-local" },
  ],
  "d1_databases": [
    {
      "binding": "FRONT_PAGE",
      "database_name": "front-page-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // KV namespace `oauth-local`.
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" },
  ],
  // Lane logs, the CLI's releases the platform serves, and code history
  // (why and a path's log), kept by immutable ids across isolates.
  "r2_buckets": [
    { "binding": "EVIDENCE", "bucket_name": "evidence-local" },
    { "binding": "RELEASES", "bucket_name": "releases-local" },
    { "binding": "CODE_CACHE", "bucket_name": "code-cache-local" },
  ],
  // Sign-in's mail (Cloudflare Email Service). `wrangler dev` only logs
  // each mail, code included, so no real mail leaves a local run.
  "send_email": [{ "name": "EMAIL" }],
  "worker_loaders": [{ "binding": "LOADER" }],
  // Workers AI, for the drafter (no key: the account's own).
  "ai": { "binding": "AI" },
  // Domain metrics (landings, refusals, lanes, waits, drafts) in Workers
  // Analytics Engine, one dataset per stage so no stage's counts mix with
  // another's. A dataset is made by its first write, so bootstrap makes none;
  // its name takes `_`, since SQL reads it as a table.
  "analytics_engine_datasets": [
    { "binding": "METRICS", "dataset": "metrics_local" },
  ],
  "services": [{ "binding": "SANDBOX", "service": "sandbox" }],
  // Namespace ids differ per stage, so one stage's counts never spend
  // another's.
  "ratelimits": [
    {
      "name": "CLAIM_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "PROPOSAL_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 },
    },
    // Sign-in attempts per handle and per client address: the
    // sixth in a minute is refused before the password is checked.
    {
      "name": "SIGN_IN_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 5, "period": 60 },
    },
    // Drafts per person: each one is a model call and Checker runs.
    {
      "name": "DRAFT_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 2, "period": 60 },
    },
  ],
  "triggers": {
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": { "namespace": "projects-local" },
        "targets": [{ "type": "workflow", "workflow_name": "on-push-local" }],
      },
    ],
  },
  "env": {
    "dev-oscabriel": {
      "vars": {
        "OPERATOR_HANDLE": "oscabriel",
        "STAGE": "dev-oscabriel",
        "LANDER_ADAPTER": "container",
        "DRAFT_MODEL": "@cf/moonshotai/kimi-k2.7-code",
        "PUBLIC_WEB_URL": "https://web-dev-oscabriel.oscargabriel.workers.dev",
      },
      "secrets": {
        "required": [
          "OPERATOR_TOKEN",
          "COOKIE_KEY",
          "PASSWORD_PEPPER",
          "MASTER_KEY",
        ],
      },
      "durable_objects": {
        "bindings": [{ "name": "PROJECT", "class_name": "Project" }],
      },
      "workflows": [
        {
          "name": "answer-dev-oscabriel",
          "binding": "ANSWER",
          "class_name": "Answer",
        },
        {
          "name": "on-push-dev-oscabriel",
          "binding": "ON_PUSH",
          "class_name": "OnPush",
        },
      ],
      "artifacts": [
        { "binding": "ARTIFACTS", "namespace": "projects-dev-oscabriel" },
        { "binding": "ARTIFACTS_PRIVATE", "namespace": "layers-dev-oscabriel" },
      ],
      "d1_databases": [
        {
          "binding": "FRONT_PAGE",
          "database_name": "front-page-dev-oscabriel",
          "database_id": "49c4ccfe-c491-49f1-9985-8296db748c4b",
          "migrations_dir": "migrations",
        },
      ],
      // KV namespace `oauth-dev-oscabriel`.
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "ddf5c48366af4ed7b93f183e7ceb3e9a" },
      ],
      "r2_buckets": [
        { "binding": "EVIDENCE", "bucket_name": "evidence-dev-oscabriel" },
        { "binding": "RELEASES", "bucket_name": "releases-dev-oscabriel" },
        { "binding": "CODE_CACHE", "bucket_name": "code-cache-dev-oscabriel" },
      ],
      "send_email": [{ "name": "EMAIL" }],
      "worker_loaders": [{ "binding": "LOADER" }],
      "ai": { "binding": "AI" },
      "analytics_engine_datasets": [
        { "binding": "METRICS", "dataset": "metrics_dev_oscabriel" },
      ],
      "services": [
        { "binding": "SANDBOX", "service": "sandbox-dev-oscabriel" },
      ],
      "ratelimits": [
        {
          "name": "CLAIM_LIMIT",
          "namespace_id": "1101",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "PROPOSAL_LIMIT",
          "namespace_id": "1102",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "SIGN_IN_LIMIT",
          "namespace_id": "1103",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "DRAFT_LIMIT",
          "namespace_id": "1104",
          "simple": { "limit": 2, "period": 60 },
        },
      ],
      "triggers": {
        "events": [
          {
            "type": "cf.artifacts.repo.pushed",
            "filter": { "namespace": "projects-dev-oscabriel" },
            "targets": [
              { "type": "workflow", "workflow_name": "on-push-dev-oscabriel" },
            ],
          },
        ],
      },
    },
    // Served on the brand's own domain, never workers.dev: infra/deploy.ts
    // passes its Custom Domain and PUBLIC_WEB_URL, which name the brand, so
    // they live in infra/stages.ts. The URL here is a stand-in the deploy's
    // --var replaces. Bootstrap writes the D1 and KV ids.
    "prod": {
      "workers_dev": false,
      "vars": {
        "OPERATOR_HANDLE": "oscabriel",
        "STAGE": "prod",
        "LANDER_ADAPTER": "container",
        "DRAFT_MODEL": "@cf/moonshotai/kimi-k2.7-code",
        "PUBLIC_WEB_URL": "https://from-infra-deploy.invalid",
      },
      "secrets": {
        "required": [
          "OPERATOR_TOKEN",
          "COOKIE_KEY",
          "PASSWORD_PEPPER",
          "MASTER_KEY",
        ],
      },
      "durable_objects": {
        "bindings": [{ "name": "PROJECT", "class_name": "Project" }],
      },
      "workflows": [
        { "name": "answer-prod", "binding": "ANSWER", "class_name": "Answer" },
        {
          "name": "on-push-prod",
          "binding": "ON_PUSH",
          "class_name": "OnPush",
        },
      ],
      "artifacts": [
        { "binding": "ARTIFACTS", "namespace": "projects-prod" },
        { "binding": "ARTIFACTS_PRIVATE", "namespace": "layers-prod" },
      ],
      "d1_databases": [
        {
          "binding": "FRONT_PAGE",
          "database_name": "front-page-prod",
          "database_id": "ebcdcb90-acd6-4fa5-ad04-eb2fc5484978",
          "migrations_dir": "migrations",
        },
      ],
      // KV namespace `oauth-prod`.
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "bcdfcea12a6e4986a0a760e7cc9c7981" },
      ],
      "r2_buckets": [
        { "binding": "EVIDENCE", "bucket_name": "evidence-prod" },
        { "binding": "RELEASES", "bucket_name": "releases-prod" },
        { "binding": "CODE_CACHE", "bucket_name": "code-cache-prod" },
      ],
      "send_email": [{ "name": "EMAIL" }],
      "worker_loaders": [{ "binding": "LOADER" }],
      "ai": { "binding": "AI" },
      "analytics_engine_datasets": [
        { "binding": "METRICS", "dataset": "metrics_prod" },
      ],
      "services": [{ "binding": "SANDBOX", "service": "sandbox-prod" }],
      "ratelimits": [
        {
          "name": "CLAIM_LIMIT",
          "namespace_id": "1301",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "PROPOSAL_LIMIT",
          "namespace_id": "1302",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "SIGN_IN_LIMIT",
          "namespace_id": "1303",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "DRAFT_LIMIT",
          "namespace_id": "1304",
          "simple": { "limit": 2, "period": 60 },
        },
      ],
      "triggers": {
        "events": [
          {
            "type": "cf.artifacts.repo.pushed",
            "filter": { "namespace": "projects-prod" },
            "targets": [
              { "type": "workflow", "workflow_name": "on-push-prod" },
            ],
          },
        ],
      },
    },
  },
}
