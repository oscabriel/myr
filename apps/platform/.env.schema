# The platform Worker's secrets. Non-secret settings live in wrangler.jsonc
# `vars`. Values go in apps/platform/.env.local (gitignored), encrypted with
# `varlock encrypt --file apps/platform/.env.local`; a person sets them, and
# the deploy hands them to the Worker. The Worker never imports varlock.
#
# @import(../../, pick=[APP_ENV])
# @defaultRequired=infer @defaultSensitive=false
# ---

# The bearer token of the one operator session, until sign-in exists. Anyone
# holding it calls the contracts as `OPERATOR_HANDLE` (wrangler.jsonc).
# @required @sensitive @type=string(minLength=32)
OPERATOR_TOKEN=

# Named sessions until GitHub sign-in exists (spec §8 D9): a JSON object from
# token to handle, `{"<token>":"alice"}`, for the demo's fictional people.
# Each token is at least 32 characters. The operator's token wins if both
# name one.
# @optional @sensitive
SESSION_TOKENS=

# GitHub sign-in (H4): the OAuth app's client id and secret, and the key that
# seals the sign-in state cookie (at least 32 characters). Set all three or
# none: without them the stage runs on the operator and named sessions.
# @optional @sensitive
GITHUB_CLIENT_ID=

# @optional @sensitive
GITHUB_CLIENT_SECRET=

# @optional @sensitive @type=string(minLength=32)
COOKIE_KEY=
