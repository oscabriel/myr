# The platform Worker's secrets. Non-secret settings live in wrangler.jsonc
# `vars`. Values go in apps/platform/.env.local (gitignored), encrypted with
# `varlock encrypt --file apps/platform/.env.local`; a person sets them, and
# the deploy hands them to the Worker. The Worker never imports varlock.
#
# @import(../../, pick=[APP_ENV])
# @defaultRequired=infer @defaultSensitive=false
# ---

# The bearer token of the one operator session. Anyone holding it calls the
# contracts as `OPERATOR_HANDLE` (wrangler.jsonc).
# @required @sensitive @type=string(minLength=32)
OPERATOR_TOKEN=

# Named sessions beside accounts: a JSON object from token to
# handle, `{"<token>":"alice"}`, for the demo's fictional people. Each token
# is at least 32 characters. The operator's token wins if both name one.
# @optional @sensitive
SESSION_TOKENS=

# Sign-in: the key a sign-in in progress is sealed into its form
# with (HMAC-SHA-256), and each mailed code's HMAC under it, at least 32
# characters. Accounts are the platform's own; the only outside service is
# the `EMAIL` binding (wrangler.jsonc), whose sending domain is onboarded
# for Email Sending on the account.
# @required @sensitive @type=string(minLength=32)
COOKIE_KEY=

# Sign-in: the pepper every password is HMAC'd with before PBKDF2,
# at least 32 characters. Without it a copy of the accounts table is
# useless; changing it makes every stored password fail to verify.
# @required @sensitive @type=string(minLength=32)
PASSWORD_PEPPER=

# Google sign-in, optional: the id of the platform's Google OAuth
# client, a "Web application" client whose authorised redirect URI is
# `<platform origin>/oauth/google/callback`. Set it with
# GOOGLE_CLIENT_SECRET or not at all; with neither, sign-in offers only a
# password. Not secret: Google shows it to everyone who signs in.
# @optional
GOOGLE_CLIENT_ID=

# Google sign-in, optional: that client's secret, set with its id.
# @optional @sensitive
GOOGLE_CLIENT_SECRET=

# Write-only env values: the 256-bit key, as 64 hex characters, that
# wraps the data key of every value a maintainer sets (WebCrypto, AES-GCM).
# Losing it loses every stored value: nobody, the platform included, can
# open one again. Keep a copy outside this machine. Changing it needs every
# value re-wrapped first.
# @required @sensitive @type=string(isLength=64, matches=regex("^[0-9a-fA-F]{64}$"))
MASTER_KEY=
