{
  // The web Worker: TanStack Start's pages, and a same-origin /rpc that
  // forwards to the platform over the PLATFORM service binding. It holds no
  // storage binding of any kind (no Artifacts, D1, KV, R2, Durable Object or
  // Worker Loader), in any stage, so a bug in a public page cannot reach a
  // repo (AGENTS.md principle 7; packages/config/test/web-wiring.test.ts).
  // No secrets either: public values are vars. Deploy only through
  // infra/deploy.ts, to an explicit stage.
  //
  // The top level is stage `local`: `vite dev` and the type generation read
  // it, and it is never deployed. Each stage under `env` repeats the binding
  // and the vars, since wrangler does not inherit them into an environment.
  //
  // Workers Cache is on in each deployed stage, and off at the top, so `vite
  // dev` keeps nothing (ADR 0026). It keys by the Worker's version, so each
  // deploy starts cold and a kept page never names another version's hashed
  // assets: `cross_version_cache` stays off.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  // TanStack Start's own server entry, wrapped so every answer passes
  // through what the edge may keep (src/server/edge-cache.ts; the Cloudflare
  // framework guide's custom entrypoint). The Cloudflare Vite plugin builds it.
  "main": "src/server.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // Every invocation's logs and trace, unsampled, and Issues. Every stage
  // inherits it, as it does the source maps below.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
    "issues": { "enabled": true },
  },
  // The server build is minified (vite.config.ts); its source maps let a
  // stack trace in the logs, or an Issue, name the source.
  "upload_source_maps": true,
  "services": [{ "binding": "PLATFORM", "service": "platform" }],
  "vars": {
    // Where a browser reaches the platform itself: its sign-in pages and
    // git remotes. /rpc never needs it; that goes through PLATFORM.
    "PUBLIC_PLATFORM_URL": "http://localhost:8787",
  },
  "env": {
    "dev-oscabriel": {
      "cache": { "enabled": true },
      "services": [
        { "binding": "PLATFORM", "service": "platform-dev-oscabriel" },
      ],
      "vars": {
        "PUBLIC_PLATFORM_URL": "https://platform-dev-oscabriel.oscargabriel.workers.dev",
      },
    },
    // Served on the brand's own domain, never workers.dev: infra/deploy.ts
    // passes its Custom Domains and PUBLIC_PLATFORM_URL, which name the brand,
    // so they live in infra/stages.ts. The URL here is a stand-in the
    // deploy's --var replaces, so the generated Env still types it a string.
    "prod": {
      "workers_dev": false,
      "cache": { "enabled": true },
      "services": [{ "binding": "PLATFORM", "service": "platform-prod" }],
      "vars": {
        "PUBLIC_PLATFORM_URL": "https://from-infra-deploy.invalid",
      },
    },
  },
}
