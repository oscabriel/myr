{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    // Vite resolves the app, and TanStack Router's generated route tree
    // imports without extensions, which NodeNext refuses.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // shadcn's generated components import through this alias
    // (components.json); Vite resolves it from here (`resolve.tsconfigPaths`).
    "paths": { "@/*": ["./src/*"] },
    "types": ["@cloudflare/workers-types", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "scripts/**/*.ts",
    "*.config.ts",
    "worker-configuration.d.ts"
  ]
}
