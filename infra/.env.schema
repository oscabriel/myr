# Tool credentials for infra/ scripts and `bun run ops` (cf). Apps never
# import this file. Values go in infra/.env.local (gitignored), encrypted with
# `varlock encrypt --file infra/.env.local`. Never create a plain infra/.env:
# cf reads .env from its working directory.
#
# @import(../, pick=[APP_ENV])
# @defaultRequired=infer @defaultSensitive=false
# ---

# The Cloudflare account that holds the Workers and Artifacts namespaces.
# @required @type=string(matches=regex("^[0-9a-f]{32}$"))
# @docs(https://developers.cloudflare.com/fundamentals/account/find-account-and-zone-ids/)
CLOUDFLARE_ACCOUNT_ID=

# An API token for ops calls and infra scripts: the "Read all resources"
# template plus Account › Artifacts › Edit. Writes anywhere else, deploys
# included, go through `wrangler login`, never this token. Its Account ›
# Account Analytics › Read lets smoke read a deploy's Workers Logs through
# the SQL API (`--since`); without it, every deploy's smoke fails.
# @required @sensitive
# @docs(https://developers.cloudflare.com/fundamentals/api/get-started/create-token/)
CLOUDFLARE_API_TOKEN=

# Where a stage's alerts are sent: one address, entered as each alert's
# email destination. A person makes the alerts by hand (README, Alerts), so
# bootstrap only says whether this is set, and never shows it.
# @type=email
# @docs(https://developers.cloudflare.com/notifications/notification-available/)
ALERT_EMAIL=

# Telemetry stays off for every tool run through varlock here.
DO_NOT_TRACK=1
CF_SEND_TELEMETRY=0

# Nothing here is a person's token. The swarm (`bun run swarm`) signs in as
# the examples' fictional people with apps/platform/.env.schema's
# SESSION_TOKENS, run as `bunx varlock run --path apps/platform/ -- bun
# scripts/swarm.ts …`, so no script or agent reads a `.env*` file. On every
# stage those tokens come from the stage's generated secrets file outside the
# repo (STAGE_SECRETS_FILE).
