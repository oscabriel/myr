{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "myr hook pre-tool-use --json",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "myr hook session-start --json",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "myr hook stop --json",
            "type": "command"
          }
        ]
      }
    ]
  }
}
