{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.config.ts",
    "infra/**/*.ts",
    "scripts/**/*.ts",
    "tools/oxlint/fence/**/*.ts",
    ".pi/extensions/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".agent_sources",
    ".turbo",
    "tools/oxlint/fence/fixtures/**"
  ]
}
