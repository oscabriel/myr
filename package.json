{
  "name": "@repo/root",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.1",
      "@effect/vitest": "4.0.1",
      "effect": "4.0.1",
      "typescript": "7.0.2",
      "vitest": "5.0.3"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript",
    "lockfile:check": "bun install --frozen-lockfile --dry-run",
    "check": "oxlint --report-unused-disable-directives-severity=error && oxfmt --check .",
    "fix": "oxlint --fix && oxfmt .",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "turbo run test",
    "brand:check": "bun scripts/brand.ts",
    "env:check": "varlock load --agent --path infra/",
    "ops": "varlock run --path infra/ -- cf",
    "verify": "bun run lockfile:check && bun run check && bun run typecheck && bun run test && bun run brand:check"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/tsgo": "0.48.1",
    "@oxlint/plugins": "1.87.0",
    "@repo/brand": "workspace:*",
    "cf": "1.0.0-beta.12",
    "effect": "catalog:",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "2.11.7",
    "typescript": "catalog:",
    "ultracite": "7.12.4",
    "varlock": "1.21.1"
  },
  "packageManager": "bun@1.4.2"
}
